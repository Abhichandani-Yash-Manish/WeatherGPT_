  "limitations": [
    "Cases declare task shape and outcome class; they do not declare exact prose or numeric values.",
    "A live run depends on current sources, the local model and the network; it is a current-clock measurement, not a replay.",
    "The holdout set must not be edited after a run is reviewed; a failure stays recorded.",
    "Ten development and four holdout cases are a starting set, not the approximately 150-case target in docs/14.",
    "This does not measure forecast skill, translation fluency or usability.",
    "The sealed holdout is ten cases authored in one sitting; it is a probe of shapes, not a sample of users.",
    "A prohibited-claim hit is a regex match, not a semantic review."
  ],
  "sealed_holdout": {
    "set": "fresh_holdout",
    "authored_at_utc": "2026-09-15T05:41:03+00:00",
    "purpose": "A sealed holdout written after the engine rounds and run once. It exists because the earlier holdout was read during development in docs/45 and can no longer measure generalisation. These cases were authored from the problem statement's shapes rather than from failures already observed, and no tuning followed the single run: the recorded outcome stands as measured.",
    "rule": "Do not tune on this set. If it is used to change the engine, it stops being a holdout and that must be recorded."
  }
