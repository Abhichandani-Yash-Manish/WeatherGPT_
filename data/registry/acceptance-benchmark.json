 "status_vocabulary": {
  "completed": "a declared task was executed and its own status is answered or explanation",
  "incomplete": "a declared task was planned and executed but reported partial, unavailable or stale",
  "missing": "a declared task was not planned at all",
  "abstained": "the turn asked for clarification, selection or reported a window outside validity instead of answering",
  "prohibited": "the answer or notes matched a prohibited-claim pattern; always a critical failure"
 },
