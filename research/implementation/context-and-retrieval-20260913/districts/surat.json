        71.62110199999998,
        382.6181180000001,
        523.3788790000001,
        494.21696799999995
      ],
      "crop": "COW",
      "crop_key": "cow",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "fea7f8558ff45138d2cea220abc904bb1c380efe3ea758adb2472e43063bf7fe",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 4,
      "text": "Housing & Hygiene: Keep animals in clean, dry sheds. Regularly sprinkle dry slaked lime (Chuna) on the floor to maintain hygiene and prevent diseases like Foot Rot and Mastitis."
    },
    {
      "bbox": [
        71.62110199999998,
        382.6181180000001,
        523.3788790000001,
        494.21696799999995
      ],
      "crop": "COW",
      "crop_key": "cow",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "14fe6305fc3444555e7719d2aacdf0015e06b31ca32837b6c4c82db687754a31",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 4,
      "text": "Fodder & Nutrition: Strictly avoid feeding old damp or fungus-infested fodder from past rains. Ensure a daily dose of mineral mixture and clean drinking water."
    },
    {
      "bbox": [
        71.62110199999998,
        382.6181180000001,
        523.3788790000001,
        494.21696799999995
      ],
      "crop": "COW",
      "crop_key": "cow",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "0cef9149d9c96e6680c393a87b36641581ef0738a278361f116703b1a59802cc",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 4,
      "text": "Healthcare: Administer deworming medicines as advised by a veterinarian and complete any pending vaccinations (FMD, HS, and BQ)."
    },
    {
      "bbox": [
        71.62110199999998,
        382.6181180000001,
        523.3788790000001,
        494.21696799999995
      ],
      "crop": "COW",
      "crop_key": "cow",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "9edd9bcf05a12320b2e6927c4de21b5c4a41fc57960ac1c0e78ebdfd7eaa636b",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 4,
      "text": "Pest Control: Clear any old stagnant water around the shed. Burn dry neem leaves in the evening to control mosquitoes, flies, and ticks."
    },
    {
      "bbox": [
        71.62110199999998,
        551.8597255,
        523.3788790000001,
        627.2643680000001
      ],
      "crop": "CHICKEN",
      "crop_key": "chicken",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "d869bd0f41b011cae6cb040045bf1a39c6151c125fb40ffec9757b5eab8007d1",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 5,
      "text": "Shed Care: Ensure ventilation; hang curtains against high winds but keep them partially open during the day."
    },
    {
      "bbox": [
        71.62110199999998,
        551.8597255,
        523.3788790000001,
        627.2643680000001
      ],
      "crop": "CHICKEN",
      "crop_key": "chicken",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "02efe80238f3f12754e6f8e887e293c73ab7999453b4017e323f8a0dc728afb5",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 5,
      "text": "Litter: Stir bedding regularly to prevent ammonia, adding slaked lime powder only on damp spots."
    },
    {
      "bbox": [
        71.62110199999998,
        551.8597255,
        523.3788790000001,
        627.2643680000001
      ],
      "crop": "CHICKEN",
      "crop_key": "chicken",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "f70493e753bc4378b723fe4b5e4f9f3a921c90b81f9e8d235c57df34f6aa2b9b",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 5,
      "text": "Feed: Store feed bags on elevated wooden pallets to prevent toxic fungal growth."
    },
    {
      "bbox": [
        71.62110199999998,
        551.8597255,
        523.3788790000001,
        627.2643680000001
      ],
      "crop": "CHICKEN",
      "crop_key": "chicken",
      "document_sha256": "5e8120cf3b228944634faa709f524f3a76c0c4e043635e4a3fce7b4739bcf9bb",
      "extraction_version": "bulletin-grid-v2",
      "id": "87bda8442c1e7cf270d9885d820be58ddb0634ddbe0c7012f4f554cba5c98191",
      "page": 3,
      "row": 2,
      "source_id": "S57",
      "stage": "",
      "table": 5,
      "text": "Health: Provide chlorinated or sanitized water, maintain vaccinations, and consult a vet if birds seem sick."
    }
  ],
