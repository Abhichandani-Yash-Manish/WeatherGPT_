        {
          "language": "en",
          "event": "Extremely heavy",
          "headline": "Heavy to very heavy with extremely heavy rainfall",
          "description": "Isolated extremely rainfall likely over Odisha on 10th September.",
          "instruction": "Action suggested\n\n\tAvoid roadway underpasses, drainage ditches, low lying areas and areas where water collects – they can unexpectedly flood or overflow.\n\t      Stay away from power lines or electrical wires.\n\t      Don’t stay in kuchcha houses during heavy rainfall as it may collapse anytime soon.\n\t       Drive carefully.",
          "severity": "Severe",
          "urgency": "Expected",
          "certainty": "Likely",
