       .then(response => response.json())
    .then(data => {
      let addressString = '';

      // Safely extract address if it exists
      if (data && data.address) {
        const addr = data.address;

        // Build address from available fields
        const parts = [];
        if (addr.village) parts.push('Village: ' + addr.village);
        if (addr.county) parts.push('Block/Taluk: ' + addr.county);
        if (addr.state_district) parts.push('District: ' + addr.state_district);
        if (addr.state) parts.push('State: ' + addr.state);
        if (addr.country) parts.push(addr.country);

        addressString = parts.join(', ');
      }

      // If no address was built, use coordinates as fallback
      if (!addressString) {
        addressString = 'Ocean / Remote area (' + lat.toFixed(4) + ', ' + lon.toFixed(4) + ')';
      }

      document.getElementById('MMELocationAddr').innerHTML = addressString;
    })
    .catch(error => {
      console.warn('Reverse geocoding failed:', error);
      document.getElementById('MMELocationAddr').innerHTML = 'Coordinates: ' + lat.toFixed(4) + ', ' + lon.toFixed(4);
    })
    .finally(() => {
      // ALWAYS call the functions that load weather data
      onmapclick(lat, lon);
      fetchWarningColor(lat, lon);
    });
});

