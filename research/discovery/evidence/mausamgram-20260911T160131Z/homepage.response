function onmapclick(lat, lon) {
  // transform to map projection
  const viewProj = map.getView().getProjection();
  const coord = ol.proj.transform([lon, lat], 'EPSG:4326', viewProj);

  // check if inside Pakistan
  let inPak = false;
  pakistanLayer.getSource().getFeatures().forEach(f => {
    if (f.getGeometry().intersectsCoordinate(coord)) inPak = true;
  });

  // if it is in Pakistan, block unless it's in an Indian-claimed area
  if (inPak) {
    let inClaimed = false;
    indiaClaimedLayer.getSource().getFeatures().forEach(f => {
      if (f.getGeometry().intersectsCoordinate(coord)) inClaimed = true;
    });

    if (!inClaimed) {
      alert('No data available for this region');
      return; // block only unclaimed Pakistan No data for this region
    }
  }

 map.removeLayer(layer);

      var latValue = lat;
      var longValue = lon;
      //console.log("in"+latValue+","+longValue);
      //latValue = Math.floor(latValue).toFixed(3);
     // longValue = Math.floor(longValue).toFixed(3);

      var latp = latValue;
      var lonp = longValue;
    
  // otherwise allow marker
  if (layer) map.removeLayer(layer);
  layer = new ol.layer.Vector({
    source: new ol.source.Vector({
      features: [ new ol.Feature({
        geometry: new ol.geom.Point(
          ol.proj.transform([lon, lat], 'EPSG:4326', 'EPSG:4326')
        )
      }) ]
    }),
    style: new ol.style.Style({
      image: new ol.style.Icon({
        anchor: [0.5,1],
        crossOrigin: 'anonymous',
        src: 'marker.png'
      })
    })
  });

  ///////////////////////////////////////////////////////////////
      map.addLayer(layer);
      
      var view = map.getView();
view.setCenter(ol.proj.transform([lon, lat], 'EPSG:4326', 'EPSG:4326')); // Make sure to transform to 'EPSG:3857'
