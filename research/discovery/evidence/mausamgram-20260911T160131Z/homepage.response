document.getElementById('geocoder-input').addEventListener('input', function () {
  performGeocode();
});

function performGeocode() {
  var query = document.getElementById('geocoder-input').value.trim();
  if (!query) {
    clearSuggestions();
    return;
  }

  var url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&countrycodes=IN&format=json&limit=5`;

  fetch(url)
    .then(response => response.json())
    .then(data => {
      displaySuggestions(data);
    })
    .catch(error => {
      console.error('Error:', error);
      clearSuggestions();
    });
}

function displaySuggestions(data) {
  var suggestionsDiv = document.getElementById('suggestions');
  suggestionsDiv.innerHTML = ''; // Clear previous suggestions

  if (data.length > 0) {
    data.forEach(item => {
      var div = document.createElement('div');
      div.className = 'suggestion-item';
      div.innerText = item.display_name;
      div.addEventListener('click', function () {
        selectSuggestion(item);
      });
      suggestionsDiv.appendChild(div);
    });
  } else {
    suggestionsDiv.innerHTML = 'No results found.';
  }
}

function selectSuggestion(item) {
  document.getElementById('geocoder-input').value = item.display_name;
  clearSuggestions();
  var lat = item.lat;
  var lon = item.lon;

  // Call the onMapClick function with the selected latitude and longitude
  onmapclick(lat, lon);
  var addr=document.getElementById('geocoder-input').value;
  document.getElementById('MMELocationAddr').innerHTML = addr;
  document.getElementById('geocoder-input').value='';
  // Optionally, perform additional actions with the selected item
  // For example, show the selected location on a map
  console.log('Selected item:', item);
}

function clearSuggestions() {
  document.getElementById('suggestions').innerHTML = '';
 
}






  </script>

