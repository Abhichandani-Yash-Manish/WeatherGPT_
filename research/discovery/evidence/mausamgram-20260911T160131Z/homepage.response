    function calculateMME() {
      //alert('in');

      //chartRH.reflow();
      MME_precipArr = [];
      MME_tempArr = [];
      MME_rhArr = [];
      MME_cloudCoverArr = [];
      MME_windspeedArr = [];
      MME_windirArr = [];
      MME_windCombined = [];


      var xmlhttp = new XMLHttpRequest();
      xmlhttp.onreadystatechange = function () {
        if (this.readyState == 4 && this.status == 200) {
          // document.getElementById("txtHint").innerHTML = this.responseText;
          var out = this.responseText;
          //console.log(out);
          //var text = out.replace(/< br>$/, '');
          //out=this.responseText;
          const obj = JSON.parse(out);
          console.log(obj);
          //var tmin=obj.tmin;
          //console.log("MME");
          //console.log(obj);
          //MME_precipArr.push('NaN');
          //MME_tempArr.push('NaN');
          //MME_rhArr.push('NaN');
          //MME_cloudCoverArr.push('NaN');

          MME_windCombined = [];
          MME_precipArr = [];
          MME_tempArr = [];
          MME_rhArr = [];
          MME_cloudCoverArr = [];
          MME_windirArr = [];
          MME_windspeedArr = [];
          MME_precipArr = obj.apcp;
          //numtmaxArr=obj.tmax;
          //numtminArr=obj.tmin;
          //console.log("MME::"+MME_precipArr);
          MME_tempArr = obj.temp;
          MME_rhArr = obj.rh;
          MME_cloudCoverArr = obj.tcdc;
          console.log("mmetemp" + MME_tempArr);
          //console.log("ecmwf"+numprecipArr_ECMWF,numtempArr_ECMWF,numrhArr_ECMWF,numcloudCoverArr_ECMWF);
          MME_windirArr = obj.wdir;
          MME_windspeedArr = obj.wspd;
          MME_windCombined.push([NaN, NaN]);

          //MME_precipArr.push('NaN')

          for (var i = 1; i < MME_windirArr.length; i++) {

            //windjoinArr.push(windspeedArr[i]);
            //windjoinArr.push(windirArr[i]);
            MME_windCombined.push([MME_windspeedArr[i], MME_windirArr[i]]);
            //alert(windjoinArr[i])
           // console.log(MME_windCombined[i]);
          }

          MMEchartRF.series[0].setData(MME_precipArr);
         // MMEcharttemp.series[0].setData(MME_tempArr);
          MMEchartRH.series[0].setData(MME_rhArr);
          MMEchartCC.series[0].setData(MME_cloudCoverArr);
          MMEchartWSWD.series[0].setData(MME_windCombined);
          MMEchartWSWD.series[1].setData(MME_windCombined);


fetchRTBCData();   // <-- Load bias-corrected realtime series


        }
      };
      xmlhttp.open("GET", "https://mausamgram.imd.gov.in/test4_mme.php?lat_gfs=" + latValue_gfs + "&lon_gfs=" + longValue_gfs + "&date=" + senddate, true);
      xmlhttp.send();



    }





//start
function fetchRTBCData() {
    if (!senddate) {
        console.error("senddate not defined");
        return;
    }
    var apiDate = senddate.split('_')[0].substring(0,8); // YYYYMMDD
    var fcstIcUtc = '00';

    var url = "rtbc_proxy.php?lat=" + latValue_gfs + "&lon=" + longValue_gfs +
              "&date=" + apiDate + "&fcst_ic_utc=" + fcstIcUtc;

    var xhr = new XMLHttpRequest();
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
            if (xhr.status === 200) {
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.fcsthours && response.temp_bc_realtime) {
                        var year = parseInt(apiDate.substring(0,4));
                        var month = parseInt(apiDate.substring(4,6)) - 1;
                        var day = parseInt(apiDate.substring(6,8));
                        var baseTimestamp = Date.UTC(year, month, day);

                        var bcRealtimePairs = [];
                        for (var i = 0; i < response.fcsthours.length; i++) {
                            var hour = response.fcsthours[i];
                            var temp = response.temp_bc_realtime[i];
                            if (temp === "NaN" || temp === null || temp === undefined) temp = NaN;
                            var timestamp = baseTimestamp + hour * 3600 * 1000;
                            bcRealtimePairs.push([timestamp, temp]);
                        }
                        
                        
                           // Helper: Find series by name in a chart
    function findSeriesByName(chart, name) {
        if (!chart || !chart.series) return null;
        for (var i = 0; i < chart.series.length; i++) {
            if (chart.series[i].name === name) return chart.series[i];
        }
        return null;
    }

                           // ---- Update MMEcharttemp ----
    if (MMEcharttemp) {
        var targetName = 'Bias-corrected Realtime(+P15)';
        var existing = findSeriesByName(MMEcharttemp, targetName);
        if (existing) {
            existing.setData(bcRealtimePairs);
            // Optionally ensure it's visible
            if (!existing.visible) existing.show();
        } else {
            MMEcharttemp.addSeries({
                name: targetName,
                color: '#E60000',
                data: bcRealtimePairs,
                showInLegend: true
            });
        }
    }

    // ---- Update main charttemp (if it exists) ----
    if (typeof charttemp !== 'undefined' && charttemp) {
        var targetNameMain = 'Bias-corrected Realtime(+P15)';
        var existingMain = findSeriesByName(charttemp, targetNameMain);
        if (existingMain) {
            existingMain.setData(bcRealtimePairs);
            if (!existingMain.visible) existingMain.show();
        } else {
            charttemp.addSeries({
                name: targetNameMain,
                color: '#ff7f0e',
                data: bcRealtimePairs,
                showInLegend: true
            });
        }
    }

                    } else {
                        console.error("RTBC API: invalid response structure", response);
                        clearRTSeries();
                    }
                } catch (e) {
                    console.error("Error parsing RTBC data", e);
                    clearRTSeries();
                }
            } else {
                console.error("HTTP error fetching RTBC data", xhr.status);
                clearRTSeries();
            }
        }
    };
    xhr.onerror = function() { console.error("Network error fetching RTBC data"); clearRTSeries(); };
    xhr.open("GET", url, true);
    xhr.send();

    function clearRTSeries() {
        if (MMEcharttemp && MMEcharttemp.series[3]) MMEcharttemp.series[3].setData([]);
        if (charttemp && charttemp.series[7]) charttemp.series[7].setData([]);
    }
}

//end









