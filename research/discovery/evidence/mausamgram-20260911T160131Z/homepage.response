	<script>
	
// Map numeric levels to hex colors
const colorMap = {
  1: "#FF0000", // Red
  2: "#FFA500", // Orange
  3: "#FFFF00", // Yellow
  4: "#00FF00", // Green
  5: "#800080"  // Purple
};

// Map hex colors to tooltip text
const tooltipTextMap = {
  "#FF0000": "Heavy Rain: 5–15 mm/hr\nCloud to Ground Lightning\nProbability > 60%",
  "#FFA500": "Moderate Rain: 5–15 mm/hr\nModerate Thunderstorm.",
  "#FFFF00": "Light Rain: <5 mm\nModerate Rain: 5–15 mm/hr",
  "#00FF00": "No Warning.",
  "#800080": "Extreme Weather Warning."
};

function updateWarningColor(value, day) {
  const colorBar = document.getElementById(`colorBar${day}`);
  const tooltipContainer = colorBar?.parentElement;

  let hexColor = null;

  if (!value) return; // nothing to process

  // Case 1: numeric string or number (e.g., "1" or 1)
  if (!isNaN(value)) {
    const numeric = Number(value);
    hexColor = colorMap[numeric] || null;
  } else {
    // Case 2: color name string (e.g., "green")
    const nameMap = {
      red: "#FF0000",
      orange: "#FFA500",
      yellow: "#FFFF00",
      green: "#00FF00",
      purple: "#800080"
    };
    hexColor = nameMap[value.toLowerCase()] || null;
  }

  if (colorBar) {
    colorBar.style.backgroundColor = hexColor || "transparent";

    // Tooltip text based on hex
    const tooltip = hexColor ? tooltipTextMap[hexColor] : "No data available.";
    if (tooltipContainer) {
      tooltipContainer.setAttribute("data-tooltip", tooltip);
    }
  }
}


	 const colorBar = document.getElementById('colorBar');
    const colorName = document.getElementById('colorName');

function fetchWarningColor(lat, lon) {

    console.log("fetchWarningColor() called with lat:", lat, "lon:", lon);

    for (let day = 1; day <= 5; day++) {

        const xhr = new XMLHttpRequest();

        xhr.open('GET',
            `get_warning_color_working.php?lat=${lat}&lon=${lon}&day=${day}`,
            true
        );

        xhr.onreadystatechange = function () {

            if (xhr.readyState === 4) {

                console.log("Day", day, "Status:", xhr.status);
                console.log("Raw response:", xhr.responseText);

                if (xhr.status === 200) {

                    try {
                        const response = JSON.parse(xhr.responseText);
                        console.log("Parsed response:", response);

                        if (response.content_color) {
                            updateWarningColor(response.content_color, day);
                        } else {
                            console.log("No content_color returned");
                        }

                    } catch (e) {
                        console.error("JSON Parse Error:", e);
                    }

                }
            }
        };

        xhr.send();
    }
}


 function displayAddress(addr){
   console.log(addr);
  document.getElementById('MMELocationAddr').innerHTML = addr;
  }

$(document).ready(function() {

    fetchOptions('pincodeState', '', '#pincodeState', 'Select State');
    fetchOptions('gpcodeState', '', '#gpcodeState', 'Select State');

    /* PINCODE */
    $('#pincodeState').change(function() {
        fetchOptions('pincodeDistrict', $(this).val(), '#pincodeDistrict', 'Select District');
    });

    $('#pincodeDistrict').change(function() {
        fetchOptions('pincodePin', $(this).val(), '#pincodePin', 'Select Pincode');
    });

    $('#pincodePin').change(function() {
        fetchOptions('pincodeArea', $(this).val(), '#pincodeArea', 'Select Area');
    });

    $('#pincodeArea').change(function() {
        var selectedOption = $(this).find('option:selected');
        var lat = selectedOption.data('lat');
        var lon = selectedOption.data('lon');

        if (lat && lon) {
            onmapclick(lat, lon);

            var addr = "State: " + $('#pincodeState').val() +
                       ", District: " + $('#pincodeDistrict').val() +
                       ", Area: " + $('#pincodeArea').val();

            displayAddress(addr);
        }
    });

    /* GP CODE */
    $('#gpcodeState').change(function() {
        fetchOptions('gpcodeDistrict', $(this).val(), '#gpcodeDistrict', 'Select District');
        $('#gpcodeBlock').html('<option value="">Select Block</option>');
        $('#gpcodeGP').html('<option value="">Select Gram Panchayat</option>');
    });

    $('#gpcodeDistrict').change(function() {
        fetchOptions('gpcodeBlock', $(this).val(), '#gpcodeBlock', 'Select Block');
        $('#gpcodeGP').html('<option value="">Select Gram Panchayat</option>');
    });

    $('#gpcodeBlock').change(function() {
        fetchOptions('gpcodeGP', $(this).val(), '#gpcodeGP', 'Select Gram Panchayat');
    });

    $('#gpcodeGP').change(function() {
        var selectedOption = $(this).find('option:selected');
        var lat = selectedOption.data('lat');
        var lon = selectedOption.data('lon');
        var gpcode = selectedOption.data('gpcode');

        if (lat && lon) {
            onmapclick(lat, lon);

            var addr = "State: " + $('#gpcodeState').val() +
                       ", District: " + $('#gpcodeDistrict').val() +
                       ", Block: " + $('#gpcodeBlock').val() +
                       ", Gram Panchayat: " + $('#gpcodeGP').val() +
                       ", GP Code: " + gpcode;

            displayAddress(addr);
        }
    });

    /* SEARCH BUTTON */
    $('#searchPincodeButton').click(function() {

        var pincode = $('#searchPincode').val();

        $.ajax({
            url: 'search_lat_lon.php',
            method: 'GET',
            dataType: 'json',
            data: { type: 'pincode', value: pincode },
            success: function(result) {

                if (result && result.lat && result.lon) {

                    var pin_addr = "State: " + result.state +
                                   " District: " + result.district +
                                   " Area: " + result.area;

                    displayAddress(pin_addr);
                    onmapclick(parseFloat(result.lat), parseFloat(result.lon));

                } else {
                    alert('No coordinates found for the given pincode.');
                }
            }
        });

    });

    $('#searchGPCodeButton').click(function() {
        var gpcode = $('#searchGPCode').val();
        $.ajax({
            url: 'search_lat_lon.php',
            method: 'GET',
            dataType: 'json',
            data: { type: 'gpcode', value: gpcode },
            success: function(result) {
                if (result.lat && result.lon) {
                    gp_addr = "State: " + result.state + " District: " + result.district + " block: " + result.block + " Gram Panchayat: " + result.gp;
                    displayAddress(gp_addr);
                    onmapclick(parseFloat(result.lat), parseFloat(result.lon));
                } else {
                    alert('No coordinates found for the given GP code.');
                }
            }
        });
    });

});


function fetchOptions(type, parentValue, targetDropdown, defaultText) {

    $.ajax({
        url: 'test4_pincode.php',
        method: 'GET',
        dataType: 'json',
        data: {
            type: type,
            parent_value: parentValue
        },
        success: function(options) {

            $(targetDropdown).empty();
            $(targetDropdown).append('<option value="">' + defaultText + '</option>');

            for (var i = 0; i < options.length; i++) {

                var option = options[i];

                for (var key in option) {

                    if (key !== 'lat' && key !== 'lon' && key !== 'gpcode') {

                        $(targetDropdown).append(
                            '<option value="' + option[key] + '" ' +
                            'data-lat="' + (option.lat || '') + '" ' +
                            'data-lon="' + (option.lon || '') + '" ' +
                            'data-gpcode="' + (option.gpcode || '') + '">' +
                            option[key] +
                            '</option>'
                        );

                    }

                }
            }

        }
    });
}



       


    

 



</script>


