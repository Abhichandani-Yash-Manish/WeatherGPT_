<style>
    
  
.container {
  padding-left: 1px !important;
  padding-right: 0 !important;
}


/* your custom.css (loaded after Bootstrap) */
.my-responsive-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -0.5rem; /* optional gutter */
}
.my-responsive-grid > div {
  flex: 0 0 100%;
  max-width: 100%;
  padding: 0.5rem; /* optional gutter */
}

/* ≥576px → 2 cols */
@media (min-width: 576px) {
  .my-responsive-grid > div {
    flex: 0 0 50%;
    max-width: 50%;
  }
}
/* ≥768px → 3 cols */
@media (min-width: 768px) {
  .my-responsive-grid > div {
    flex: 0 0 33.3333%;
    max-width: 33.3333%;
  }
}
/* ≥992px → 4 cols */
@media (min-width: 992px) {
  .my-responsive-grid > div {
    flex: 0 0 25%;
    max-width: 25%;
  }
}




    #suggestions {
      border: 0px solid #ccc;
      max-height: 200px;
      overflow-y: auto;
      position: absolute;
      background: white;
      width: 30%;
      z-index: 1000;
    }
    .suggestion-item {
      padding: 8px;
      cursor: pointer;
    }
    .suggestion-item:hover {
      background-color: #ddd;
    }
  </style>
  <style>
    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
    }

    #map {

      width: 100%;
      height: 50%;
      overflow: scroll;
      border: 0.5px solid #4CAF50;
    }



    body {
      font-family: "Lato", sans-serif;
    }


    .openbtn {
      font-size: 20px;
      cursor: pointer;
      background-color: #111;
      color: white;
      padding: 10px 15px;
      border: none;
    }

    .openbtn:hover {
      background-color: #444;
    }



    .grid-container {
      display: grid;

      padding: 2px;
    }

    .grid-item {


      font-size: 30px;
      text-align: center;
    }




    .grid-container {
      display: grid;
      grid-template-columns: auto auto auto;
      background-color: #2196F3;
      grid-gap: -10px;

    }

    .grid-item {
      background-color: rgba(255, 255, 255, 0.8);
      /* border: 0.5px solid rgba(0, 0, 0, 0.8);*/

      text-align: center;
    }


    .highcharts-figure,
    .highcharts-data-table table {
      min-width: 400px;
      max-width: 100%;
      margin: 0 0 0 0;
      max-height: 380px;
    }


    .highcharts-data-table table {
      font-family: Verdana, sans-serif;
      text-align: center;
      width: 100%;
      max-width: 500px;
    }

    .highcharts-data-table caption {
      padding: 1em 0;
      font-size: 1.2em;
      color: #555;
    }

    .highcharts-data-table th {
      font-weight: 600;

    }

    .highcharts-data-table td,
    .highcharts-data-table th,
    .highcharts-data-table caption {
      padding: 0.5em;
    }

    .highcharts-data-table thead tr,
    .highcharts-data-table tr:nth-child(even) {
      background: #f8f8f8;
    }

    .highcharts-data-table tr:hover {
      background: #f1f7ff;
    }



    .block_container {
      text-align: center;
    }

    .bloc1 {
      display: inline-block;
    }


    .floatBlock {
      margin: 0 1.81em 0 0;
    }

    .labelish {
      color: #000000;
      margin: 0;
    }

    .searchOptions {
      border: none;
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      break-before: always;
      margin: 0 0 1em 0;
    }

    #purchaseOrder {
      margin: 0 0 2em 0;
    }

    .header {

      text-align: center;
      background: linear-gradient(90deg, rgba(14, 144, 235, 1) 7%, rgba(245, 238, 13, 1) 30%, rgba(120, 253, 29, 1) 51%, rgba(252, 176, 69, 1) 89%);
      color: white;
      font-size: 30px;
      height: 100px
    }

    .element {
      height: 50px;
      width: 50px;
      margin: 10px;
    }
    .element .p{
     margin-bottom: 0px !important;
}
    .Bancontainer {
      display: flex;
      justify-content: right;
      flex-direction: column;
      align-items: right;
      height: 10vh;
      background: linear-gradient(to bottom, #57c1eb 0%, #246fa8 100%);

    }

    .elements {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;


    }

    .telements {

      margin-top: 2px;

    }



    .white {
      fill: #FFFFFF
    }

    .gray {
      fill: #E0E0E0
    }

    .yellow {
      fill: #FFEB3B
    }


    .demo {
padding-right: 0px;
padding-bottom: 10px;
padding-left: 0px;
      text-align: center;

    }

.element .p {
  margin: 0 !important;
  
}


    .nav>li>a:hover, .nav>li>a:focus, .nav>li>a.active {
    background-color: #cad8da;
  }
  .panel-group {
    height: auto !important;
  }
  </style>
  
    <style>
@keyframes flash {
  0%   { opacity: 1; }
  50%  { opacity: 0.2; }
  100% { opacity: 1; }
}
</style>

<style>
  .warning-container {
      display: flex;
      align-items: flex-start;
      margin: 20px;
  }
  
  .warning-label {
      margin-bottom: 0px;
      font-weight: bold;
    white-space: nowrap;
  }
  
  .color-bars {
      display: flex;
      justify-content:flex-start ;
  }
  
  .color-bar-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 0; /* Remove any extra margin between bars */
  }
  
  .color-bar {
      width: 100px;
      height: 20px;
      border: 1px solid #000;
      margin: 0; /* Ensure no space between color bars */
  }
  
  .day-label {
      margin-top: 5px;
      font-weight: bold;
      text-align: center;
  }
   
