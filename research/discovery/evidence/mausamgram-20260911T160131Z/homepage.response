    ////go to location

    function GotoLocation() {

      lat = parseFloat(document.getElementById('lat').value);
      lon = parseFloat(document.getElementById('lon').value);

      // Converting lat long to mercator projection
      //  proj_lat_long = ol.proj.fromLonLat([lat, lon])

      // Zoom to lat lon
      map.setView(
        new ol.View({
          projection: 'EPSG:4326',
          center: [lon, lat],
          zoom: 8
        }));
      // overlay.element.innerHTML = 'Lat: ' + lat + '<br/> Lon: ' + lon;


      //onmapclick(lat,lon);
      // Set popup position to lat lon

      popup.show([lon, lat]);
      // overlay.setPosition([lon,lat]);

      onmapclick(lat, lon)
    }


    //array of past 10 dates

    function getDaterange(start, end, arr) {
      if (!moment(start).isSameOrAfter(end)) {
        if (arr.length == 0) {
          arr.push(moment(start).format("ddd, Do MMM YYYY"));
          console.log("in daterange" + arr[0]);
          // interimdatearr.push(moment(start).format("YYYYMMDD"));
        }
        var next = moment(start).add(1, 'd');
        arr.push(next.format("ddd, Do MMM YYYY"));
        console.log("in daterange-->" + arr[0]);
        //interimdatearr.push(next.format("YYYYMMDD"));
        getDaterange(next, end, arr);
      } else {
        return arr;
      }
      return arr;
    }








