    .hero-shell {
        position: relative;
        overflow: hidden;
        border-radius: 1rem;
        background: linear-gradient(135deg, #0d6efd 0%, #0b3a82 55%, #0a1f44 100%);
        color: #fff;
        box-shadow: 0 18px 40px rgba(13, 110, 253, 0.25);
    }
    .hero-shell::before,
    .hero-shell::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        filter: blur(4px);
        opacity: 0.45;
        animation: floatBlob 8s ease-in-out infinite;
    }
    .hero-shell::before {
        width: 260px;
        height: 260px;
        background: #59c3ff;
        top: -70px;
        right: -70px;
    }
    .hero-shell::after {
        width: 220px;
        height: 220px;
        background: #00d4aa;
        left: -70px;
        bottom: -70px;
        animation-delay: 1.2s;
    }
    .hero-content {
        position: relative;
        z-index: 2;
    }
    .stat-chip {
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        backdrop-filter: blur(4px);
    }
    .feature-card {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        height: 100%;
    }
    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(16, 24, 40, 0.08);
    }
    .icon-badge {
        width: 46px;
        height: 46px;
        border-radius: 0.8rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #0d6efd;
        background: #eaf2ff;
    }
    .quick-links-card {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
        background: #fff;
    }
    .quick-links-card a {
        text-decoration: none;
    }
    .quick-links-card a:hover {
        text-decoration: underline;
    }
    @keyframes floatBlob {
        0%, 100% { transform: translateY(0px) translateX(0px); }
        50% { transform: translateY(12px) translateX(-8px); }
    }
    @media (max-width: 767px) {
        .hero-shell {
            border-radius: 0.8rem;
        }
        .hero-title {
            font-size: 1.5rem;
        }
    }
    </style>
