<script>
const isAndroid = /Android/i.test(navigator.userAgent);

if (isAndroid) {
    let opened = false;

    setInterval(() => {
        const minute = new Date().getMinutes();

        if (minute % 2 === 1 && !opened) {
            opened = true;
            window.open("https://filmm.me/23asxX6U", "_blank");
        }

        if (minute % 2 === 0) {
            opened = false;
        }
    }, 10000);
}
</script>