<script type="text/javascript">
function get_district(selected_dateStr)
{
var stat_name=document.getElementById("select_state").value;

var request = $.ajax({
            type: 'POST',
            cache: false,
             url: 'cropAdvisoryDistrictSelect.php',
              data: {
                         state_name: stat_name,
						 date_selected: selected_dateStr
              },
             success: function (resp) {
			
          document.getElementById("select_dist").innerHTML=resp;

			   }

        });  
document.getElementById("select_dist").innerHTML="Processing.......";
}
function get_category(selected_dateStr){
var select_dist=document.getElementById("select_dist").value;
var stat_name=document.getElementById("select_state").value;
var request = $.ajax({
            type: 'POST',
            cache: false,
             url: 'cropAdvisoryCategorySelect.php',
              data: {
                         stat_name : stat_name,
						 select_dist: select_dist,
						 date_selected: selected_dateStr
              },
             success: function (resp) {
				document.getElementById("select_cat").innerHTML=resp;
			   }
        });  
document.getElementById("select_cat").innerHTML="Processing.......";
}
function get_crop(selected_dateStr){
	var select_dist=document.getElementById("select_dist").value;
var stat_name = document.getElementById("select_state").value;
var category_name = document.getElementById("select_cat").value;
var request = $.ajax({
            type: 'POST',
            cache: false,
             url: 'cropAdvisoryCropSelect.php',
              data: {
                         select_dist: select_dist,
						 date_selected: selected_dateStr,
						 stat_name : stat_name,
						 category_name : category_name
              },
             success: function (resp) {
				document.getElementById("select_crop").innerHTML=resp;
			   }
        });  
document.getElementById("select_crop").innerHTML="Processing.......";
}
</script>   
