"areasSettings": {
    "autoZoom": true,
      "selectable": true,
//    "selectedColor": "#C2DFFF",
    "unlistedAreasAlpha": 0.3
  },
"imagesSettings": {
 //   "labelRollOverColor": "#000",
  //  "labelPosition": "bottom"
  //   useTargetsZoomValues: true
  "selectable" :true
  }
};








var map = AmCharts.makeChart( "chartdiv", {
  "type": "map",
  "theme": "light",
"zoomControl": {
		"zoomControlEnabled": false
		//"minZoomLevel": 1.3
	},
 // "color": "#FFCC00",
//  "colorSteps": 10,
//"imagesSettings": {
 //   "labelRollOverColor": "#000",
  //  "labelPosition": "bottom"
     useTargetsZoomValues: true,
        "autoZoom": true,

  //},
 "listeners": [ 
{
	"event": "rendered",
	"method": function check(){
	//Zoomed to center of the state...
	map.zoomToLongLat(5,71.1924,22.2587,true);

	}
},

{
    "event": "clickMapObject",
    "method": function( e ) {
       //alert(e.mapObject.ajaxUrl);
       if ( e.mapObject.ajaxUrl !== undefined ) {
        // add "description" if it was emptyi
         e.mapObject.description =undefined;
        if ( e.mapObject.description === undefined )
          e.mapObject.description = "<div id='mapcontent'>Loading...</div>";
        
  //        alert( e.mapObject.description); 
//           e.mapObject.description=e.mapObject.ajaxUrl;
        // delay loading by a bit so that map can finish displaying description box and zoom
        setTimeout( function() {
           if(e.mapObject.label=="New Delhi")
           {
             e.mapObject.label="NewDelhi";
            }
          $( "#mapcontent" ).load( e.mapObject.ajaxUrl+"?id="+e.mapObject.label );
         
        }, 1000 );
   document.getElementById( "city_weather" ).innerHTML =   e.mapObject.description ;
//   document.getElementById('temperature').innerHTML=10; 

 e.mapObject.description ="";
    }
 e.mapObject.description =undefined;
    }
  } ],
 "areasSettings": {
    "autoZoom": true,
    "selectedColor": "#C2CFFD",
      "rollOverColor": "#C2DFFF",

    "unlistedAreasAlpha": 0.3
  },
 "dataProvider": GujaratdataProvider,
// "dataProvider": countrydataprovider,
"allLabels": [{
    "id": "xx",   /// id which is used for css customization
    "text": "Current Weather",
    "bold": true,
    "x": "80%",
    "y": "3%",
    "rotation": 0,
    "width": "100%",
    "size": 13,
    "align": "middle",
  }],
"hideCredits":"true"



} );


function handleGoHome() {

map.zoomToMapXY(2,-1.277,-2.2461,true);
map.zoomToLongLat(5,71.1924,22.2587,true);


}

function handleMapObjectClick(event) {
  if (event.mapObject.id == "backButton") {
    handleGoHome();
  }
}

function handleZoom()
{

}

// monitor when home icon was clicked and also go to continents map
map.addListener("homeButtonClicked", handleGoHome);
map.addListener("clickMapObject", handleMapObjectClick);
map.addListener("zoomed", handleZoom);


</script>

</div>
  </body>
  
</html>
