<style>
/* The Modal (background) */
.modal {
  display: none; /* Hidden by default */
  position: fixed; /* Stay in place */
  z-index: 999; /* Sit on top */
/*  padding-top: 100px; /* Location of the box */*/
  left: 0;
  top: 0;
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  overflow: auto; /* Enable scroll if needed */
  background-color: rgb(0,0,0); /* Fallback color */
  background-color: rgba(0,0,0,0.5); /* Black w/ opacity */
}

/* Modal Content (image) */
.modal-content {
  margin: auto;
  display: block;
  width: 100%;
  max-width: 600px;
  padding: 4px;
}

/* Caption of Modal Image */
#caption {
  margin: auto;
  display: block;
  width: 80%;
  max-width: 900px;
  text-align: center;
  color: #ccc;
  padding: 10px 0;
  height: 150px;
}

#countDown {
  color: #b13f23;
  font-weight: bold;
  font-size: 12px;
  padding: 10px;
  text-align: center;
  display: block;
  margin: 1px auto;
  max-width: 700px;
  border-radius: 5px;
  background: #e5faf9;
}

/* Add Animation */
.modal-content, #caption {  
  -webkit-animation-name: zoom;
  -webkit-animation-duration: 0.6s;
  animation-name: zoom;
  animation-duration: 0.6s;
}

.link-cross {
  position: relative;
  display: block;
  margin: 13% auto;
  max-width: 600px;
  text-align: center;
}

@-webkit-keyframes zoom {
  from {-webkit-transform:scale(0)} 
  to {-webkit-transform:scale(1)}
}

@keyframes zoom {
  from {transform:scale(0)} 
  to {transform:scale(1)}
}

/* The Close Button */
.close {
  position: absolute;
  top: -20px;
  right: -20px;
  color: #f1f1f1;
  font-size: 28px;
  transition: 0.3s;
  z-index: 10;
  padding: 0;
  line-height: 50px;
  width: 50px;
  height: 50px;
  border-radius: 50px;
  background: rgba(150,150,150,0.75);
}

.close:hover,
.close:focus {
  color: #bbb;
  text-decoration: none;
  cursor: pointer;
}

/* 100% Image Width on Smaller Screens */
@media only screen and (max-width: 1000px){
  .modal-content {
    width: 100%;
  }
  #countDown {
    font-size: 16px;
    padding: 10px;
  }
  .close {
    color: #fff;
    top: 5px;
    right: 5px;
    width: 30px;
    line-height: 30px;
  height: 30px;
  border-radius: 30px;
  }
  .link-cross {
    margin: 40% auto;
  }
}
</style>

<script>
  // function for close button 
  function clocse() { 
    document.getElementById("myModal").style.display = "none";
  }
</script>


