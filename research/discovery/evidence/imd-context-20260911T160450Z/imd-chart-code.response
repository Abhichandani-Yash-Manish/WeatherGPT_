  },
  exporting: {
         enabled: true
},


    yAxis: {
		lineColor: '#000000',
        lineWidth: 2,
	gridLineWidth: 1,
        title: {
            text: ''
        },
		
		labels: {
                style: {
				fontSize: 14,
                    fontWeight: 'bold',
                    color:'#000000'
                }
            },
    },

    xAxis: {
		 
		lineColor: '#000000',
        lineWidth: 2,
	 
		type: "datetime",
	  gridLineWidth: 1, 
       type: "datetime",
	    minorTickInterval: tickint * 3600 * 1000,
		tickInterval: mjrtickint * 3600 * 1000,
      	minorTickPosition:'outside',
      	minorTickLength:10,
        minorTickWidth: 1,
        minorGridLineWidth: 0,
				gridLineWidth: 1, 
         min: Date.UTC(y, m-1, d,tutc) ,
        max: Date.UTC(y, m-1, d +addday) ,       
      labels: {
         formatter: function() {
        return Highcharts.dateFormat('%d/%m <br/> %I %p',
                                      this.value);
      },
	   style: {
				fontSize: 14,
                    fontWeight: 'bold',
                    color:'#000000'
                }
      
      }        
     
    },

   

    plotOptions: {
        label: {
                connectorAllowed: false
            },
            pointStart: 0
    },

    series: [{
        showInLegend: false, 
		 name: 'Temperature',
		color:'#FF5B0D',
        data: [],//max temp
        pointStart: Date.UTC(y, m-1, d,tutc),
    pointInterval: 3600 * tickint * 1000 // one hour
    }
    ],

    responsive: {
        rules: [{
            condition: {
                maxWidth: 500
            },
            chartOptions: {
                legend: {
                    layout: 'horizontal',
                    align: 'center',
                    verticalAlign: 'bottom'
                }
            }
        }]
    }

});

