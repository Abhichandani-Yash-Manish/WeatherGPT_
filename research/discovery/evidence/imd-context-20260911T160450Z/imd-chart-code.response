MMEchartWSWD = Highcharts.chart('myMMEchartWSWD', {
credits: {
    enabled: false
},
chart: {
       
        zoomType: 'x',
        panning: true,
        panKey: 'shift'
    },

    title: {
        text: ''
    },
time: {
    timezone: 'Asia/Calcutta'
  },
    xAxis: {
		 lineColor: '#000000',
        lineWidth: 2,
     
        type: 'datetime',
        offset: 40,  
		gridLineWidth: 1, 
               
    
	
       
	    minorTickInterval: tickint * 3600 * 1000,
		tickInterval: mjrtickint * 3600 * 1000,
      	minorTickPosition:'outside',
