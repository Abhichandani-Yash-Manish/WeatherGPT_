function initializeCharts()
{
	
var dateFormat = '%e/%m/%Y/%H:%M';
 
Highcharts.setOptions( {
       
        global : {
            useUTC : false
        }
    } );

MMEchartRF	=	Highcharts.chart('myMMEchartRF', {

chart: {
        type: 'column',
		zoomType: 'x',
        panning: true,
        panKey: 'shift'
		
		
    },
credits: {
    enabled: false
},
    title: {
        text: ''
    },
exporting: {
         enabled: true,
		 
},
 time: {
    timezone: 'Asia/Calcutta'
  },

    yAxis: {
		lineColor: '#000000',
        lineWidth: 2,
        title: {
            text: ''
        },
		 gridLineWidth: 1, 
		 labels: {
                style: {
				fontSize: 14,
                    fontWeight: 'bold',
                    color:'#000000'
                }
            },
		 
    },

    xAxis: {
		lineColor: '#000000',
        lineWidth: 2,
	title: {
      text: ''
    },
       type: "datetime",
	    minorTickInterval: tickint * 3600 * 1000,
		tickInterval: mjrtickint * 3600 * 1000,
      	minorTickPosition:'outside',
      	minorTickLength:10,
        minorTickWidth: 1,
        minorGridLineWidth: 0,
				gridLineWidth: 1, 
         min: Date.UTC(y, m-1, d,tutc),
        max: Date.UTC(y, m-1, d+addday),       
      labels: {
         formatter: function() {
        return Highcharts.dateFormat('%d/%m <br/> %I %p',
                                      this.value);
      },
	   style: {
				fontSize: 14,
                    fontWeight: 'bold',
                    color:'#000000',
					
					textoverflow:"none",
                },
				overflow:false,
      
      }
    },

    legend: {
        layout: 'vertical',
        align: 'right',
        verticalAlign: 'middle'
    },

    plotOptions: {
       column: {
            pointPadding: 0.2,
            borderWidth: 0
        }
    },

    series: [{
	 showInLegend: false, 
	 name: 'Rainfall',
		color:'#0000DD',
        data: [],
        pointStart: Date.UTC(y, m-1, d,tutc),
		pointInterval: 3600 * tickint * 1000 // one hour
    }
	],

    responsive: {
        rules: [{
            condition: {
                maxWidth: 500
            },
            chartOptions: {
                legend: {
                    layout: 'horizontal',
                    align: 'center',
                    verticalAlign: 'bottom'
                }
            }
        }]
    }

});

MMEcharttemp	= Highcharts.chart('myMMEchartTemp', {
	
	chart: {
        
		zoomType: 'x',
        panning: true,
        panKey: 'shift',
		
		
    },
	
 credits: {
    enabled: false
},
 title: {
        text: ''
    },
 time: {
