{
  "name": "weathergpt-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:probe": "vite build --config vite.probe.config.ts",
    "ui:install": "playwright install chromium",
    "ui:shots": "node tools/capture.mjs",
    "ui:tokens": "node tools/tokens.mjs",
    "ui:a11y": "playwright test tests/ui/a11y.spec.ts",
    "ui:visual": "playwright test tests/ui/visual.spec.ts",
    "ui:visual:update": "playwright test tests/ui/visual.spec.ts --update-snapshots",
    "ui:routes": "playwright test tests/ui/routes.spec.ts",
    "ui:diff": "python3 ../scripts/ui/fidelity.py"
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-serif-gujarati": "^5.3.0",
    "@fontsource/tiro-bangla": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@fontsource/tiro-kannada": "^5.3.0",
    "@fontsource/tiro-tamil": "^5.3.0",
    "@fontsource/tiro-telugu": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.6",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
